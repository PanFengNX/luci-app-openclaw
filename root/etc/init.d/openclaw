#!/bin/sh /etc/rc.common
# OpenClaw 助手 - procd service
#
# Stability rules borrowed from iStoreOS's luci-app-openclawmgr (and tightened):
#   * never start on a privileged port (<=1024)  -> would fight SSH/LuCI
#   * only pass --force when the port is >1024 AND lsof/fuser exists, so
#     OpenClaw can never kill the router's own management services
#   * `--allow-unconfigured` so the gateway comes up even without a model
#   * respawn 3600 10 5 - give up only after 10 crashes in an hour
#   * locate the CLI entry from several candidates (npm layout changes)

START=99
STOP=10
USE_PROCD=1

OC_UCI="openclaw"
OC_USER="openclaw"

uci_get() {
	local v
	v="$(uci -q get "${OC_UCI}.${1}" 2>/dev/null)"
	printf '%s' "${v:-${2:-}}"
}

json_get() {
	local file="$1" expr="$2"
	[ -f "$file" ] || return 0
	command -v jsonfilter >/dev/null 2>&1 || return 0
	jsonfilter -i "$file" -e "$expr" 2>/dev/null | head -n1
}

oc_base_dir() {
	local d
	d="$(uci_get main.base_dir '')"
	[ -n "$d" ] || d="/mnt/data/OpenClaw"
	# never turn "/" into "" (an empty value would make derived paths relative)
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}

oc_node_mode() {
	# 必须与 lib.sh 的 oc_node_mode() 保持一致
	local m
	m="$(uci_get main.node_mode private)"
	case "$m" in global) printf 'global' ;; *) printf 'private' ;; esac
}

oc_node_dir() {
	# global 模式下运行时是系统共享的 /usr/lib/nodejs，不是 <安装目录>/node
	# （那里根本没有 node）。漏改这里服务会直接起不来。
	if [ "$(oc_node_mode)" = "global" ]; then
		printf '/usr/lib/nodejs'
	else
		printf '%s/node' "$(oc_base_dir)"
	fi
}

oc_node_bin() {
	# global 模式优先 /usr/bin/node（存在且可执行时），否则退回运行时目录。
	# 与 lib.sh 的 oc_node_bin() 一致 —— oc_gateway_pids() 靠 argv[0] 匹配进程，
	# 两边取到的路径必须相同。
	if [ "$(oc_node_mode)" = "global" ]; then
		if [ -x /usr/bin/node ]; then
			printf '/usr/bin/node'
		else
			printf '/usr/lib/nodejs/bin/node'
		fi
		return 0
	fi
	printf '%s/node/bin/node' "$(oc_base_dir)"
}
oc_oc_dir() {
	# 必须与 lib.sh 的 oc_oc_dir() 保持一致：程序目录可以独立于安装目录，
	# 这里漏改的话服务会去 <安装目录>/openclaw 找一个并不存在的程序。
	local d
	d="$(uci_get main.openclaw_dir '')"
	[ -n "$d" ] || d="$(oc_base_dir)/openclaw"
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}
oc_state_dir() {
	# 必须与 lib.sh 的 oc_state_dir() 保持一致。本文件不 source lib.sh
	# （lib.sh 在加载期就会建私有 rundir、装 trap，对 init 脚本太重），
	# 所以只能各留一份 —— 与上面 oc_base_dir/oc_node_mode/oc_oc_dir 同一套路，
	# 全部复用本文件已有的 uci_get()，不另起一套配置读取。
	#
	# 默认 <安装目录>/home/.openclaw（历史行为）；main.state_dir 非空时以它为准。
	local d
	d="$(uci_get main.state_dir '')"
	[ -n "$d" ] || d="$(oc_base_dir)/home/.openclaw"
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}

_state_dir_shape_ok() {
	# _state_dir_shape_ok <dir> -> 0 ok / 1 reject
	#
	# 纯字符串过滤，不碰文件系统。_state_dir_safe() 会对「原路径」和
	# 「readlink -f 之后的物理路径」各调用一次，所以逻辑只留这一份。
	#
	# 只接受：绝对路径、不是 "/"、无 "."/".." 段、不在系统前缀下、至少两级
	# （/mnt/data 可以，/mnt 太顶层 —— 递归操作容易误伤整块盘）。
	local d="$1"
	[ -n "$d" ] || return 1
	case "$d" in
		/*) ;;
		*) return 1 ;;
	esac
	[ "$d" != "/" ] || return 1
	# 前导 "//" 会绕过下面的前缀匹配（"//etc" 等价于 "/etc"），直接拒绝
	case "$d" in
		//*) return 1 ;;
	esac
	case "$d" in
		*"/../"*|*"/.."|*"/./"*|*"/.") return 1 ;;
	esac
	case "$d" in
		/bin|/bin/*|/sbin|/sbin/*|/usr|/usr/*|/lib|/lib/*|/lib64|/lib64/*|/etc|/etc/*) return 1 ;;
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) return 1 ;;
		/tmp|/tmp/*|/var|/var/*|/overlay|/overlay/*|/rom|/rom/*) return 1 ;;
		/root|/root/*|/boot|/boot/*) return 1 ;;
	esac
	# 至少两级：去掉首个 "/" 后必须还剩一个 "/"
	case "${d#/}" in
		*/*) ;;
		*) return 1 ;;
	esac
	return 0
}

_state_dir_safe() {
	# _state_dir_safe <dir> -> 0 safe / 1 unsafe
	#
	# main.state_dir 是用户可配置路径，下面会对它做 `chown -R` / `chmod -R`。
	# 落到系统目录上是灾难，所以动手前必须校验。
	#
	# 与 lib.sh 的 oc_validate_base_dir 三层校验口径一致：
	#   1. 形态过滤（_state_dir_shape_ok）—— 绝对路径、不是 "/"、无 "."/".." 段、
	#      不在系统前缀下、至少两级
	#   2. 物理解析 —— `/mnt/data/OpenClaw -> /etc` 能骗过纯字符串过滤，但随后
	#      的 `chown -R` / `chmod -R` 会跟随链接，所以存在时必须 readlink -f
	#      取物理路径，并对物理路径再做一遍同样的过滤
	#   3. 末段本身不能是符号链接 —— `chown -R link` 会解引用它的参数，
	#      直接打到链接目标那棵树上
	#
	# ⚠️ 前缀黑名单必须与 lib.sh 的 oc_validate_base_dir_shape() 保持一致
	#    （本文件不 source lib.sh，只能各留一份，同 oc_state_dir() 的做法）。
	#    这里在其基础上补了 /lib64 与 /boot；/run 也在 lib.sh 的列表里。
	local d="$1" phys
	_state_dir_shape_ok "$d" || return 1

	# 第 3 层：路径本身就是符号链接，拒绝
	if [ -L "$d" ]; then
		return 1
	fi

	# 第 2 层：路径存在时才谈得上解析。新建目录（不存在）只过字符串过滤。
	if [ -e "$d" ]; then
		phys="$(readlink -f "$d" 2>/dev/null)" || phys=""
		# 存在却解析不出来：宁可拒绝，也不要放行一个看不清的路径
		[ -n "$phys" ] || return 1
		# 物理路径可能落到 /etc、/var 之类，必须再过一遍形态过滤
		_state_dir_shape_ok "$phys" || return 1
		# 物理路径与原路径不同 => 中间某一段是链接。随后会对该路径递归
		# chown/chmod，链接目标可能不在我们预期的挂载点上，一律拒绝。
		[ "$phys" = "$d" ] || return 1
	fi

	return 0
}

oc_home()     { printf '%s/home' "$(oc_base_dir)"; }

_find_entry() {
	local d="${1}/lib/node_modules/openclaw" e
	for e in "$d/openclaw.mjs" "$d/dist/cli.js" "$d/dist/index.js" "$d/openclaw.js"; do
		[ -f "$e" ] && { printf '%s' "$e"; return 0; }
	done
	return 1
}

# collect KEY=value pairs the gateway should see (API keys etc.)
_env_args() {
	local envf="$1" k v out=""
	[ -f "$envf" ] || { printf '%s' "$out"; return 0; }
	while IFS='=' read -r k v; do
		case "$k" in ''|\#*) continue ;; esac
		case "$k" in *[!A-Za-z0-9_]*) continue ;; esac
		v="${v%\"}"; v="${v#\"}"
		# skip empty values and anything containing whitespace: procd_set_param
		# env takes a flat list, spaces would corrupt it
		[ -n "$v" ] || continue
		case "$v" in *' '*|*'	'*) continue ;; esac
		out="$out $k=$v"
	done <"$envf"
	printf '%s' "$out"
}

start_service() {
	local base nodedir globaldir home state_dir entry node_bin
	local port bind token json_port json_bind json_token cfg envfile
	local force_opt="" user_opt="" env_args=""

	config_load "$OC_UCI"
	config_get_bool enabled main enabled 0
	config_get base_dir main base_dir ""

	base="$(oc_base_dir)"
	nodedir="$(oc_node_dir)"
	globaldir="$(oc_oc_dir)"
	home="$(oc_home)"
	# 数据根：默认 $home/.openclaw，main.state_dir 可指向别处（已有安装/大容量盘）。
	# 必须用同一个值推导 cfg 与 .env —— 否则服务会从一个目录启动、从另一个目录
	# 读 token，直接 Refuse to start。
	state_dir="$(oc_state_dir)"
	# 解释器路径跟随 node_mode（global 模式是 /usr/bin/node）
	node_bin="$(oc_node_bin)"
	cfg="${state_dir}/openclaw.json"

	[ "$enabled" -eq 1 ] || return 0

	# --- runtime values: JSON wins, UCI is the fallback
	port="$(uci_get main.port 18789)"
	bind="$(uci_get main.bind lan)"
	token=""
	json_port="$(json_get "$cfg" '@.gateway.port')"
	json_bind="$(json_get "$cfg" '@.gateway.bind')"
	json_token="$(json_get "$cfg" '@.gateway.auth.token')"
	[ -n "$json_port" ] && port="$json_port"
	[ -n "$json_bind" ] && bind="$json_bind"
	[ -n "$json_token" ] && token="$json_token"

	# --- safety: numeric, unprivileged port
	case "$port" in
		''|*[!0-9]*)
			logger -t openclaw "Refusing to start: port '$port' is not numeric"
			return 1 ;;
	esac
	if [ "$port" -le 1024 ] 2>/dev/null; then
		logger -t openclaw "Refusing to start: unsafe port $port (must be >1024)"
		return 1
	fi
	if [ "$port" -gt 65535 ] 2>/dev/null; then
		logger -t openclaw "Refusing to start: invalid port $port"
		return 1
	fi

	[ -x "$node_bin" ] || { logger -t openclaw "Node.js 运行时缺失：$node_bin"; return 1; }
	entry="$(_find_entry "$globaldir")" || {
		logger -t openclaw "OpenClaw 未安装（$globaldir 下找不到入口），请先安装运行环境"
		return 1
	}
	[ -n "$token" ] || { logger -t openclaw "未生成网关 token，拒绝启动"; return 1; }

	mkdir -p "$state_dir/workspace" "$base/logs" "$base/workspace" "$base/tmp" 2>/dev/null || true
	chmod 700 "$base/tmp" 2>/dev/null || true
	if id "$OC_USER" >/dev/null 2>&1; then
		chown "$OC_USER:$OC_USER" "$base/tmp" 2>/dev/null || true
	fi

	# --- --force lets OpenClaw kill a conflicting listener, but only when it
	#     can do so safely and only on unprivileged ports.
	if [ "$port" -gt 1024 ] 2>/dev/null &&
		{ command -v lsof >/dev/null 2>&1 || command -v fuser >/dev/null 2>&1; }; then
		force_opt="--force"
	fi

	if id "$OC_USER" >/dev/null 2>&1; then
		user_opt="$OC_USER"
		chown -R "$OC_USER:$OC_USER" "$home" 2>/dev/null || true
		chmod -R u+rwX "$home" 2>/dev/null || true
		# state_dir 在 $home 之外时（迁移已有安装），上面的 chown 覆盖不到它，
		# 服务用户对网关要写的 openclaw.json / 会话 / 工作区没有权限。
		# 但这是用户可配置路径：先校验再递归操作，不安全的只告警、继续启动。
		if [ "$state_dir" != "$home/.openclaw" ]; then
			if _state_dir_safe "$state_dir"; then
				chown -R "$OC_USER:$OC_USER" "$state_dir" 2>/dev/null || true
				chmod -R u+rwX "$state_dir" 2>/dev/null || true
			else
				logger -t openclaw "state_dir 不在允许清理的范围内，跳过属主修正：$state_dir"
			fi
		fi
	fi

	env_args="$(_env_args "$state_dir/.env")"

	procd_open_instance "gateway"
	# The token is NOT passed as --token any more: every local user can read
	# /proc/<pid>/cmdline, so the credential was world readable for as long as
	# the gateway ran. OPENCLAW_GATEWAY_TOKEN below is the documented
	# equivalent (it even takes precedence over the config file).
	procd_set_param command "$node_bin" "$entry" gateway run \
		--port "$port" --bind "$bind" --auth token \
		--allow-unconfigured $force_opt
	# HOME / OPENCLAW_HOME 表示进程 HOME，与 state 目录是两个概念，保持不变。
	# 但 STATE_DIR / CONFIG_PATH 不能写死 "$home/.openclaw"：main.state_dir 可
	# 覆盖 state_dir（迁移已有安装到大容量盘），写死会让网关与 UI 操作
	# 不同的目录 —— 网关按这里读 token、UI 按 state_dir 写配置，表现为
	# 「改了模型/端口不生效」「API Key 写了仍报未配置」。
	# shellcheck disable=SC2086
	procd_set_param env \
		HOME="$home" \
		OPENCLAW_HOME="$home" \
		OPENCLAW_STATE_DIR="$state_dir" \
		OPENCLAW_CONFIG_PATH="${state_dir}/openclaw.json" \
		OPENCLAW_GATEWAY_PORT="$port" \
		OPENCLAW_GATEWAY_BIND="$bind" \
		OPENCLAW_GATEWAY_TOKEN="$token" \
		TMPDIR="$base/tmp" \
		PATH="${nodedir}/bin:${globaldir}/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
		$env_args
	[ -n "$user_opt" ] && procd_set_param user "$user_opt"
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t openclaw "started (base=$base port=$port bind=$bind)"
}

stop_service() {
	# procd stops the instance; never blanket-kill by name here (that used to
	# take down unrelated processes matching 'openclaw').
	rm -f /var/run/openclaw.pid 2>/dev/null || true
	logger -t openclaw "stopped"
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$OC_UCI"
}
