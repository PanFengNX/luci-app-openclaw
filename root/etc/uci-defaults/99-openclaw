#!/bin/sh
# openclaw - first boot defaults

[ -x /usr/libexec/openclaw/lib.sh ] || exit 0
. /usr/libexec/openclaw/lib.sh

OC_USER="openclaw"

uci -q get openclaw.main >/dev/null 2>&1 || {
	uci -q set openclaw.main=main
}

# port / bind / versions
[ -n "$(uci -q get openclaw.main.port)" ]     || uci -q set openclaw.main.port=18789
[ -n "$(uci -q get openclaw.main.bind)" ]     || uci -q set openclaw.main.bind=lan
[ -n "$(uci -q get openclaw.main.oc_version)" ]   || uci -q set openclaw.main.oc_version=latest
[ -n "$(uci -q get openclaw.main.node_version)" ] || uci -q set openclaw.main.node_version=auto
# Node.js 部署方式：global（默认，/usr/lib/nodejs + /usr/bin 链接）| private（运行时在安装目录内）
[ -n "$(uci -q get openclaw.main.node_mode)" ] || uci -q set openclaw.main.node_mode=global
[ -n "$(uci -q get openclaw.main.preinstall_providers)" ] || uci -q set openclaw.main.preinstall_providers=deepseek

# 数据根目录（openclaw.json / .env / 会话 / 工作区都在它下面）。
# 空字符串是**合法默认值**：表示沿用 <安装目录>/home/.openclaw 的历史行为。
# 所以这里不能用上面那些 [ -n ] 写法 —— 空值会让判断永远为假，把"显式留空"
# 和"键不存在"混为一谈；只有「键不存在」才需要写入默认值。
uci -q get openclaw.main.state_dir >/dev/null 2>&1 || uci -q set openclaw.main.state_dir=""

# pick the largest writable mount as the default base dir.
# NOTE: /var was deliberately removed from the candidate list - on many
# devices it is a tmpfs mount (RAM) AND oc_validate_base_dir() rejects it,
# so picking it produced a default the installer would always refuse.
# /root and /overlay are excluded for the same reason. A fresh device with
# no external storage simply keeps the /mnt/data default and gets a clear
# error in the UI instead of a silently broken configuration.
pick_base() {
	local best="" bestfree=0 p free
	for p in $(df -m 2>/dev/null | awk 'NR>1{print $6}' | grep -E '^/(mnt|data|nvme|sd|mmc|usb)'); do
		[ -d "$p" ] || continue
		[ -w "$p" ] || continue
		free="$(df -m "$p" 2>/dev/null | awk 'NR==2{print $4}')"
		[ -n "$free" ] || free=0
		if [ "$free" -gt "$bestfree" ]; then best="$p"; bestfree="$free"; fi
	done
	# whatever we picked must survive the safety checks used everywhere else
	[ -n "$best" ] && oc_validate_base_dir "$best/OpenClaw" || best=""
	printf '%s' "$best"
}

cur="$(uci -q get openclaw.main.base_dir)"
if [ -z "$cur" ]; then
	b="$(pick_base)"
	[ -n "$b" ] && uci -q set openclaw.main.base_dir="$b/OpenClaw"
fi

uci -q commit openclaw

# system account
oc_ensure_user >/dev/null 2>&1

# prepare directories
base="$(uci -q get openclaw.main.base_dir)"
if [ -n "$base" ]; then
	mkdir -p "$base" "$base/home" "$base/logs" 2>/dev/null
	oc_fix_perms >/dev/null 2>&1
fi

chmod +x /etc/init.d/openclaw 2>/dev/null
chmod +x /usr/libexec/istorec/openclaw.sh 2>/dev/null
chmod +x /usr/libexec/openclaw/*.sh 2>/dev/null

rm -f /tmp/luci-indexcache 2>/dev/null
exit 0
