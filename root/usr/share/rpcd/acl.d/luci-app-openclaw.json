{
	"luci-app-openclaw": {
		"description": "Grant read access to OpenClaw 助手 (openclaw) logs and configuration. Writes go through cli.sh, which validates paths; no ubus write grant is needed.",
		"read": {
			"file": {
				"/etc/config/openclaw": [
					"read"
				],
				"/var/log/openclaw.log": [
					"read"
				],
				"/var/log/openclaw-install.log": [
					"read"
				],
				"/var/log/openclaw-task.log": [
					"read"
				],
				"/var/log/openclaw-backup.log": [
					"read"
				],
				"/var/log/openclaw.log.1": [
					"read"
				],
				"/var/log/openclaw-task.log.1": [
					"read"
				],
				"/var/log/openclaw-backup.log.1": [
					"read"
				]
			}
		}
	}
}
