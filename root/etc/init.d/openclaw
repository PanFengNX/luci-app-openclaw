#!/bin/sh /etc/rc.common
# OpenClaw 助手 - procd service
#
# Stability rules:
#   * never start on a privileged port (<=1024)  -> would fight SSH/LuCI
#   * only pass --force when the port is >1024 AND lsof/fuser exists, so
#     OpenClaw can never kill the router's own management services
#   * `--allow-unconfigured` so the gateway comes up even without a model
#   * respawn 3600 5 0 - never give up (see the comment at the call site)
#   * locate the CLI entry from several candidates (npm layout changes)

START=99
STOP=10
USE_PROCD=1

OC_UCI="openclaw"
OC_USER="openclaw"

uci_get() {
	local v
	v="$(uci -q get "${OC_UCI}.${1}" 2>/dev/null)"
	printf '%s' "${v:-${2:-}}"
}

json_get() {
	local file="$1" expr="$2"
	[ -f "$file" ] || return 0
	command -v jsonfilter >/dev/null 2>&1 || return 127
	# **不要**接 head -n1：值里含换行时 jsonfilter 输出多行，head 会静默截成
	# 第一行，截断后的"半截凭据"看起来仍是合法明文，会被当成完整值用下去。
	# 完整取回，交给调用方判断（端口/绑定等纯数字值本来就不含换行）。
	jsonfilter -i "$file" -e "$expr" 2>/dev/null
}

# ---------------------------------------------------------------- 凭据判定
# 与 repair / install 共用同一个无副作用的结构化判定器；不 source lib.sh，避免
# 引入其载入期副作用（rundir、trap）。缺文件时禁止启动，绝不退回形状猜测。
OC_CREDENTIAL_LIB="/usr/libexec/openclaw/credential.sh"
if [ -r "$OC_CREDENTIAL_LIB" ]; then
	. "$OC_CREDENTIAL_LIB"
else
	oc_credential_state() {
		OC_CRED_STATE=UNREAD
		OC_CRED_ENV=""
		OC_CRED_DESC="缺少凭据判定库 $OC_CREDENTIAL_LIB"
	}
fi

oc_base_dir() {
	local d
	d="$(uci_get main.base_dir '')"
	[ -n "$d" ] || d="/mnt/data/OpenClaw"
	# never turn "/" into "" (an empty value would make derived paths relative)
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}

oc_node_mode() {
	# 必须与 lib.sh 的 oc_node_mode() 保持一致
	local m
	m="$(uci_get main.node_mode private)"
	case "$m" in global) printf 'global' ;; *) printf 'private' ;; esac
}

oc_node_dir() {
	# global 模式下运行时是系统共享的 /usr/lib/nodejs，不是 <安装目录>/node
	# （那里根本没有 node）。漏改这里服务会直接起不来。
	if [ "$(oc_node_mode)" = "global" ]; then
		printf '/usr/lib/nodejs'
	else
		printf '%s/node' "$(oc_base_dir)"
	fi
}

oc_node_bin() {
	# global 模式优先 /usr/bin/node（存在且可执行时），否则退回运行时目录。
	# 与 lib.sh 的 oc_node_bin() 一致 —— oc_gateway_pids() 靠 argv[0] 匹配进程，
	# 两边取到的路径必须相同。
	if [ "$(oc_node_mode)" = "global" ]; then
		if [ -x /usr/bin/node ]; then
			printf '/usr/bin/node'
		else
			printf '/usr/lib/nodejs/bin/node'
		fi
		return 0
	fi
	printf '%s/node/bin/node' "$(oc_base_dir)"
}
oc_oc_dir() {
	# 必须与 lib.sh 的 oc_oc_dir() 保持一致：程序目录可以独立于安装目录，
	# 这里漏改的话服务会去 <安装目录>/openclaw 找一个并不存在的程序。
	local d
	d="$(uci_get main.openclaw_dir '')"
	[ -n "$d" ] || d="$(oc_base_dir)/openclaw"
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}
oc_state_dir() {
	# 必须与 lib.sh 的 oc_state_dir() 保持一致。本文件不 source lib.sh
	# （lib.sh 在加载期就会建私有 rundir、装 trap，对 init 脚本太重），
	# 所以只能各留一份 —— 与上面 oc_base_dir/oc_node_mode/oc_oc_dir 同一套路，
	# 全部复用本文件已有的 uci_get()，不另起一套配置读取。
	#
	# 默认 <安装目录>/home/.openclaw（历史行为）；main.state_dir 非空时以它为准。
	local d
	d="$(uci_get main.state_dir '')"
	[ -n "$d" ] || d="$(oc_base_dir)/home/.openclaw"
	d="${d%/}"
	[ -n "$d" ] || d="/"
	printf '%s' "$d"
}

_state_dir_shape_ok() {
	# _state_dir_shape_ok <dir> -> 0 ok / 1 reject
	#
	# 纯字符串过滤，不碰文件系统。_state_dir_safe() 会对「原路径」和
	# 「readlink -f 之后的物理路径」各调用一次，所以逻辑只留这一份。
	#
	# 只接受：绝对路径、不是 "/"、无 "."/".." 段、不在系统前缀下、至少两级
	# （/mnt/data 可以，/mnt 太顶层 —— 递归操作容易误伤整块盘）。
	local d="$1"
	[ -n "$d" ] || return 1
	case "$d" in
		/*) ;;
		*) return 1 ;;
	esac
	[ "$d" != "/" ] || return 1
	# 前导 "//" 会绕过下面的前缀匹配（"//etc" 等价于 "/etc"），直接拒绝
	case "$d" in
		//*) return 1 ;;
	esac
	case "$d" in
		*"/../"*|*"/.."|*"/./"*|*"/.") return 1 ;;
	esac
	case "$d" in
		/bin|/bin/*|/sbin|/sbin/*|/usr|/usr/*|/lib|/lib/*|/lib64|/lib64/*|/etc|/etc/*) return 1 ;;
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) return 1 ;;
		/tmp|/tmp/*|/var|/var/*|/overlay|/overlay/*|/rom|/rom/*) return 1 ;;
		/root|/root/*|/boot|/boot/*) return 1 ;;
	esac
	# 至少两级：去掉首个 "/" 后必须还剩一个 "/"
	case "${d#/}" in
		*/*) ;;
		*) return 1 ;;
	esac
	return 0
}

_state_dir_existing_path_ok() {
	local path="$1" rest component prefix="/"
	rest="${path#/}"
	while [ -n "$rest" ]; do
		case "$rest" in
			*/*) component="${rest%%/*}"; rest="${rest#*/}" ;;
			*) component="$rest"; rest="" ;;
		esac
		[ -n "$component" ] || continue
		prefix="${prefix%/}/$component"
		[ -L "$prefix" ] && return 1
	done
	return 0
}

_state_dir_safe() {
	# _state_dir_safe <dir> -> 0 safe / 1 unsafe
	#
	# main.state_dir 是用户可配置路径，下面会对它做 `chown -R` / `chmod -R`。
	# 落到系统目录上是灾难，所以动手前必须校验。
	#
	# 与 lib.sh 的 oc_validate_base_dir 三层校验口径一致：
	#   1. 形态过滤（_state_dir_shape_ok）—— 绝对路径、不是 "/"、无 "."/".." 段、
	#      不在系统前缀下、至少两级
	#   2. 物理解析 —— `/mnt/data/OpenClaw -> /etc` 能骗过纯字符串过滤，但随后
	#      的 `chown -R` / `chmod -R` 会跟随链接，所以存在时必须 readlink -f
	#      取物理路径，并对物理路径再做一遍同样的过滤
	#   3. 末段本身不能是符号链接 —— `chown -R link` 会解引用它的参数，
	#      直接打到链接目标那棵树上
	#
	# ⚠️ 前缀黑名单必须与 lib.sh 的 oc_validate_base_dir_shape() 保持一致
	#    （本文件不 source lib.sh，只能各留一份，同 oc_state_dir() 的做法）。
	#    这里在其基础上补了 /lib64 与 /boot；/run 也在 lib.sh 的列表里。
	local d="$1" phys
	_state_dir_shape_ok "$d" || return 1
	_state_dir_existing_path_ok "$d" || return 1

	# 第 3 层：路径本身就是符号链接，拒绝
	if [ -L "$d" ]; then
		return 1
	fi

	# 第 2 层：路径存在时才谈得上解析。新建目录（不存在）只过字符串过滤。
	if [ -e "$d" ]; then
		phys="$(readlink -f "$d" 2>/dev/null)" || phys=""
		# 存在却解析不出来：宁可拒绝，也不要放行一个看不清的路径
		[ -n "$phys" ] || return 1
		# 物理路径可能落到 /etc、/var 之类，必须再过一遍形态过滤
		_state_dir_shape_ok "$phys" || return 1
		# 物理路径与原路径不同 => 中间某一段是链接。随后会对该路径递归
		# chown/chmod，链接目标可能不在我们预期的挂载点上，一律拒绝。
		[ "$phys" = "$d" ] || return 1
	fi

	return 0
}

oc_home()     { printf '%s/home' "$(oc_base_dir)"; }

# 权限修正失败不阻止启动（权限问题不该让服务起不来），但必须留下痕迹：
# 静默吞掉的结果是网关以错误的权限运行，日志里却只有一行正常的 started。
_warn_chown() {
	# exfat / vfat / ntfs 没有 uid/gid 语义，chown 必然失败 —— 那不是故障，
	# 用户也无从修复。这类文件系统上把话改成说明性的，别冒充告警。
	if ! oc_fs_supports_fowner "$1"; then
		logger -t openclaw "说明：$1 所在文件系统不支持设置属主（exfat/vfat/ntfs），已跳过 chown；网关改用文件权限位访问"
		return 0
	fi
	# 文件系统**支持**属主却失败了，说明是真问题（只读挂载、子挂载不支持、
	# inode 用尽、某个子文件不可改）。此前一律 2>/dev/null，导致只能看到
	# "失败了"、永远查不出为什么 —— 这是本项目反复踩过的坑：
	# 静默吞掉错误 = 永远找不到根因。
	# 第二个参数由调用方传入（chown 的 stderr 第一行）——
	# 不在这里重跑一次 chown -R：那等于把几万文件再遍历一遍只为读一条错误。
	if [ -n "${2:-}" ]; then
		logger -t openclaw "警告：无法把 $1 的属主改为 $OC_USER：$2"
	else
		logger -t openclaw "警告：无法把 $1 的属主改为 $OC_USER，网关可能因权限不足失败"
	fi
}

# 跑一次 chown -R，失败时把**第一条**报错交给 _warn_chown。
# 用一个私有临时文件接 stderr：命令替换会把换行折叠，且我们要保留原始文本。
_fix_owner() {
	local d="${1:-}" errf err
	[ -n "$d" ] && [ -d "$d" ] || return 0
	# init.d 不 source lib.sh，$OC_RUNDIR 在这里是空的 —— 拼出来会变成
	# "/chown.err.<pid>"，往根目录写文件。优先用 $base/tmp（调用方已建、0700，
	# 靠 ash 的动态作用域可见）；拿不到时退到 /tmp。
	# 这里只接一条错误信息，没有保密要求，但绝不能拼出绝对根路径。
	errf="${base:-/tmp}/tmp/chown.err.$$"
	[ -d "$(dirname "$errf")" ] || errf="/tmp/chown.err.$$"
	if chown -R "$OC_USER:$OC_USER" "$d" 2>"$errf"; then
		rm -f "$errf" 2>/dev/null
		return 0
	fi
	err="$(head -n 1 "$errf" 2>/dev/null)"
	rm -f "$errf" 2>/dev/null
	_warn_chown "$d" "$err"
}

_warn_chmod() {
	logger -t openclaw "警告：无法修正 $1 的权限，网关可能因权限不足失败"
}

_find_entry() {
	local d="${1}/lib/node_modules/openclaw" e
	for e in "$d/openclaw.mjs" "$d/dist/cli.js" "$d/dist/index.js" "$d/openclaw.js"; do
		[ -f "$e" ] && { printf '%s' "$e"; return 0; }
	done
	return 1
}

# collect KEY=value pairs the gateway should see (API keys etc.)
_env_args() {
	local envf="$1" k v out=""
	[ -f "$envf" ] || { printf '%s' "$out"; return 0; }
	while IFS='=' read -r k v; do
		case "$k" in ''|\#*) continue ;; esac
		case "$k" in *[!A-Za-z0-9_]*) continue ;; esac
		v="${v%\"}"; v="${v#\"}"
		# skip empty values and anything containing whitespace: procd_set_param
		# env takes a flat list, spaces would corrupt it
		[ -n "$v" ] || continue
		case "$v" in *' '*|*'	'*) continue ;; esac
		out="$out $k=$v"
	done <"$envf"
	printf '%s' "$out"
}

oc_schema_heal() {
	# 启动前自检：把"恢复备份 / 升级 OpenClaw 之后网关起不来"这一类故障
	# 就地修掉。
	#
	# 症状（实测）：恢复回来的是旧布局数据，agent 库 schema 24 而新版要求 25，
	# 日志写 "uses schema version 24 ... run openclaw doctor --fix"，
	# procd 每次启动都 exit_code=1、端口根本不开 —— 看起来像"服务挂了"，
	# 实际只差一次 doctor --fix。
	#
	# 判据刻意收得很紧，只在上一次网关日志里**同时**出现
	# "schema version" 与 "doctor --fix" 时才动手：
	#   * 不无条件跑 doctor —— 它要遍历整个状态目录，几秒到几十秒，
	#     不该拖慢每一次开机；
	#   * 每次开机最多一次（标记放在 /tmp 下的 rundir，重启即清空），
	#     避免 doctor 修不好时变成"启动 → 修 → 启动"的死循环；
	#   * doctor 失败也照常继续启动，让 procd 的重启策略接手。
	#
	# oc_schema_heal <base> <state_dir> <home> <node_bin> <entry>
	local base="$1" state_dir="$2" home="$3" node_bin="$4" entry="$5"
	local marker log f tail_txt

	marker="/tmp/.openclaw/schema-healed"
	[ -e "$marker" ] && return 0

	# 网关日志：$TMPDIR/openclaw-<uid>/openclaw-*.log，取最新的一份。
	log=""
	for f in "$base"/tmp/openclaw-*/openclaw-*.log; do
		[ -f "$f" ] || continue
		if [ -z "$log" ] || [ "$f" -nt "$log" ]; then log="$f"; fi
	done
	[ -n "$log" ] || return 0

	tail_txt="$(tail -n 200 "$log" 2>/dev/null)"
	case "$tail_txt" in
		*"schema version"*) ;;
		*) return 0 ;;
	esac
	case "$tail_txt" in
		*"doctor --fix"*) ;;
		*) return 0 ;;
	esac

	mkdir -p /tmp/.openclaw 2>/dev/null
	: >"$marker" 2>/dev/null
	logger -t openclaw "状态库 schema 版本落后（日志：$log），自动执行 doctor --fix --force"
	# 必须以**服务用户**执行，不能以 root 直跑：
	#   * doctor 会在 state/ 下新建或重写 sqlite、日志、插件目录。root 跑出来的
	#     文件属主是 root，网关随后 EACCES 或只读 —— 典型的"修了反而起不来"；
	#   * root 上下文看不到服务用户的扩展插件（openclaw 会以
	#     "suspicious ownership ... expected uid=0 or root" 把它们全部判为候选
	#     无效），它据此做的 reconcile 可能把插件记录删掉。
	# 固定脚本体；路径与命令一律走位置参数，不拼进 shell 代码（避免注入）。
	# $1=家目录 $2=state 目录 $3=node bin 目录，其余为命令。
	# 注意 cwd 用家目录而不是 state：doctor 会往 cwd 里落临时文件，
	# state 目录里落下的任何东西都必须由服务用户自己创建。
	if command -v su >/dev/null 2>&1; then
		su -s /bin/sh "$OC_USER" -c '
			cd "$1" 2>/dev/null || cd /tmp || exit 1
			export HOME="$1"
			export OPENCLAW_STATE_DIR="$2"
			export OPENCLAW_CONFIG_PATH="$2/openclaw.json"
			export PATH="$3:/usr/sbin:/usr/bin:/sbin:/bin"
			shift 3
			if command -v timeout >/dev/null 2>&1; then
				exec timeout 300 "$@"
			else
				exec "$@"
			fi
		' sh "$home" "$state_dir" "${node_bin%/*}" \
			"$node_bin" "$entry" doctor --fix --force >/dev/null 2>&1
	else
		logger -t openclaw "缺少 su，跳过自动 doctor --fix（请手动以 $OC_USER 执行）"
	fi
	logger -t openclaw "doctor --fix --force 结束（以 $OC_USER 执行），继续启动"
	return 0
}

# ── 临时根：与 lib.sh 的 oc_pin_system_tmp_root / oc_sweep_stale_tmp 一致 ──
# 本文件不 source lib.sh，只能各留一份（同 oc_state_dir() 的做法）。
# 这两处必须在**服务启动路径**里跑：/tmp 是 tmpfs，重启即失。
_probe_user_write() {
	# 以**服务用户身份**验证目录可写 —— 唯一可信的判据。
	#
	# root 的 [ -w ] / stat -c %U 只能看出"属主名字对不对"，看不出服务用户
	# 能否访问（root 对被 root 拥有的 0755 目录永远可写）。这正是
	# "权限看着正常却 EACCES" 的根源。
	#
	# 实现：把探测脚本写进一个变量，用 su -c 执行；避免在 su 命令串里
	# 嵌套引号（那是上一版写法的问题，可读性差且容易错）。
	local d="${1:-}" probe rc
	[ -d "$d" ] || return 1
	# 用固定文件名 + $$，与调用进程绑定；写在目标目录里才能真正验证可写性。
	probe="$d/.oc-write-probe.$$"
	su -s /bin/sh "$OC_USER" -c "touch '$probe' 2>/dev/null" 2>/dev/null
	rc=$?
	if [ "$rc" -eq 0 ] && [ -f "$probe" ]; then
		rm -f "$probe" 2>/dev/null || true
		return 0
	fi
	rm -f "$probe" 2>/dev/null || true
	return 1
}

_is_tmp_root() {
	# _is_tmp_root <path> -> 0 当且仅当 basename 是 openclaw-<纯数字>
	#
	# 为什么不能只靠 glob openclaw-[0-9]*：那一层还有 openclaw-<date>.log
	# （形如 openclaw-2026-10-25.log，以数字开头，会被 glob 命中）。
	# 靠 [ -d ] 挡掉文件是不够的 —— 判据要独立成立，不依赖"它恰好是文件"。
	local n suf
	n="${1##*/}"
	case "$n" in openclaw-*) ;; *) return 1 ;; esac
	suf="${n#openclaw-}"
	case "$suf" in ''|*[!0-9]*) return 1 ;; esac
	return 0
}

_pin_system_tmp_root() {
	mkdir -p /tmp/openclaw 2>/dev/null || return 0
	chown root:root /tmp/openclaw 2>/dev/null || true
	chmod 700 /tmp/openclaw 2>/dev/null || true
	return 0
}

_sweep_stale_tmp() {
	# 只匹配 openclaw-[0-9]：同层还有 openclaw-update-report-*、
	# openclaw-update-run-handoff-*、openclaw-<date>.log，用 openclaw-*
	# 会把它们一起删掉。
	#
	# ⚠️ 绝不清 $state_dir/tmp —— OpenClaw 2026.10 起状态所有权锁住在
	#   $OPENCLAW_STATE_DIR/tmp/openclaw-<uid>/state.<hash>.lock，
	# 删掉它会让数据库留下指向已消失进程的维护租约，网关与 doctor 双双卡死。
	local uid d root o name
	uid="$(id -u "$OC_USER" 2>/dev/null)"
	case "${uid:-}" in ''|*[!0-9]*) return 0 ;; esac
	for root in "$base/tmp" /tmp; do
		[ -d "$root" ] || continue
		[ "$root" = "$state_dir/tmp" ] && continue
		for d in "$root"/openclaw-*; do
			[ -d "$d" ] || continue
			# 必须是 openclaw-<纯数字>（同层还有 openclaw-<date>.log）
			_is_tmp_root "$d" || continue
			name="${d##*/}"
			[ "${name#openclaw-}" = "$uid" ] && continue
			o="$(stat -c %u "$d" 2>/dev/null)"
			rm -rf "$d" 2>/dev/null && \
				logger -t openclaw "已清理残留临时根 $d（原属主 uid=${o:-未知}）"
		done
	done
	return 0
}

start_service() {
	local base nodedir globaldir home state_dir entry node_bin
	local port bind token json_port json_bind cfg envfile
	local authmode cred_state cred_desc pw_env authpw prc
	local force_opt="" user_opt="" env_args=""

	# 配置文件理论上由 postinst 从模板生成，但设备上可能被手工删掉 ——
	# config_load 读不到时返回非 0，这里显式容错，让下面全部走 uci_get 的默认值，
	# 而不是让 start_service 半途停住。
	config_load "$OC_UCI" || true
	config_get_bool enabled main enabled 0
	# core dump 默认关：core 文件可能有几百 MB，反复崩会把路由器的存储写满。
	# 排查 native 层崩溃（段错误）时才临时打开。
	config_get_bool core_dumps main core_dumps 0
	config_get base_dir main base_dir ""

	base="$(oc_base_dir)"
	nodedir="$(oc_node_dir)"
	globaldir="$(oc_oc_dir)"
	home="$(oc_home)"
	# 数据根：默认 $home/.openclaw，main.state_dir 可指向别处（已有安装/大容量盘）。
	# 必须用同一个值推导 cfg 与 .env —— 否则服务会从一个目录启动、从另一个目录
	# 读 token，直接 Refuse to start。
	state_dir="$(oc_state_dir)"
	# 解释器路径跟随 node_mode（global 模式是 /usr/bin/node）
	node_bin="$(oc_node_bin)"
	cfg="${state_dir}/openclaw.json"

	[ "$enabled" -eq 1 ] || return 0

	# main.state_dir 是用户可填的路径。_state_dir_safe() 一直只有定义、
	# 没有调用点，等于从未校验 —— 填 /etc 就会在下面 mkdir 出 /etc/workspace、
	# 把配置与状态写进系统目录，且 repair/adopt 的递归 chown 也会跟着打到那里。
	#
	# 按本文件既有的 fail-closed 口径处理（与服务用户不存在、VAR 域属主不对
	# 同一口径）：拒绝启动并给出可直接执行的修复命令。
	# 刻意**不**回退到默认目录 —— 那会让既有数据目录被静默换掉、用户看到的
	# 是"配置丢了"，而数据目录属于公开契约（见 docs/UPGRADE-COMPAT.md）。
	# 位置必须在 enabled 判断之后：未启用时不该因为配置问题报启动失败。
	if ! _state_dir_safe "$state_dir"; then
		logger -t openclaw "拒绝启动：main.state_dir 未通过安全校验（$state_dir）"
		logger -t openclaw "修复：把 main.state_dir 改成安装目录下的子路径（至少两级），或清空以使用默认数据目录"
		return 1
	fi

	# --- runtime values: JSON wins, UCI is the fallback
	port="$(uci_get main.port 18789)"
	bind="$(uci_get main.bind lan)"
	json_port="$(json_get "$cfg" '@.gateway.port')"
	json_bind="$(json_get "$cfg" '@.gateway.bind')"
	[ -n "$json_port" ] && port="$json_port"
	[ -n "$json_bind" ] && bind="$json_bind"

	# auth.mode 缺省按 token；显式未知值拒绝，不能静默把用户配置改成另一种认证。
	authmode_raw="$(json_get "$cfg" '@.gateway.auth.mode')"
	if [ -z "$authmode_raw" ]; then
		authmode="token"
	else
		case "$authmode_raw" in
			token|password|none|trusted-proxy) authmode="$authmode_raw" ;;
			*)
				logger -t openclaw "拒绝启动：未知 gateway.auth.mode '$authmode_raw'（允许 token/password/none/trusted-proxy）"
				return 1
				;;
		esac
	fi
	oc_credential_state "$cfg"
	cred_state="$OC_CRED_STATE"
	cred_desc="$OC_CRED_DESC"
	token="$OC_CRED_ENV"

	# --- safety: numeric, unprivileged port
	case "$port" in
		''|*[!0-9]*)
			logger -t openclaw "Refusing to start: port '$port' is not numeric"
			return 1 ;;
	esac
	if [ "$port" -le 1024 ] 2>/dev/null; then
		logger -t openclaw "Refusing to start: unsafe port $port (must be >1024)"
		return 1
	fi
	if [ "$port" -gt 65535 ] 2>/dev/null; then
		logger -t openclaw "Refusing to start: invalid port $port"
		return 1
	fi

	[ -x "$node_bin" ] || { logger -t openclaw "Node.js 运行时缺失：$node_bin"; return 1; }
	entry="$(_find_entry "$globaldir")" || {
		logger -t openclaw "OpenClaw 未安装（$globaldir 下找不到入口），请先安装运行环境"
		return 1
	}
	# 凭据门。判据来自 OC_CRED_STATE，四种失败各自一句文案 ——
	# 现场最贵的成本是"从一条概括消息反推它卡在哪个分支"。
	# 只有 mode=token 时才强制要求凭据；其它 mode 按配置走。
	case "$cred_state" in
		PLAIN|REF) ;;
		MISSING)
			if [ "$authmode" = "token" ]; then
				logger -t openclaw "未配置网关凭据（gateway.auth.token 缺失，配置 $cfg），拒绝启动"
				logger -t openclaw "修复：/usr/libexec/openclaw/repair.sh   （或 LuCI「一键修复」）"
				return 1
			fi
			;;
		BADREF)
			if [ "$authmode" = "token" ]; then
				logger -t openclaw "网关凭据引用不完整（$OC_CRED_DESC，配置 $cfg），拒绝启动"
				logger -t openclaw "修复：检查 gateway.auth.token 的 source/id，或用 repair.sh 重建"
				return 1
			fi
			;;
		UNREAD)
			# 解析失败时无法可信读取 auth.mode；即使配置声称 none/password，也拒绝。
			logger -t openclaw "无法读取/解析配置 $cfg（$cred_desc），拒绝启动"
			return 1
			;;
		*)
			logger -t openclaw "拒绝启动：内部凭据判定状态无效"
			return 1
			;;
		esac
	if [ "$authmode" = "token" ]; then
		case "$cred_state" in PLAIN|REF) ;; *) return 1 ;; esac
	fi
	[ "$cred_state" = "PLAIN" ] && [ -n "$cred_desc" ] && \
		logger -t openclaw "提示：$cred_desc"
	# 引用式凭据（REF）绝不导出到环境变量：那会让 /proc/<pid>/environ
	# 常驻一段 JSON，网关拿它认证必然失败。这里 token 只可能是 PLAIN 的明文。

	# 服务用户是启动前提，不是可选项：procd 的 user 参数一旦缺失，网关会以
	# root 运行 —— 它对外监听 LAN 并执行模型工具调用，等于把路由器交出去。
	# 与上面的 token 检查同一口径（fail-closed）：用户不存在就不启动。
	if ! id "$OC_USER" >/dev/null 2>&1; then
		logger -t openclaw "服务用户 $OC_USER 不存在，拒绝以 root 启动网关（请重新安装本插件以创建该用户）"
		return 1
	fi
	user_opt="$OC_USER"

	mkdir -p "$state_dir/workspace" "$base/logs" "$base/workspace" "$base/tmp" 2>/dev/null || true
	chmod 700 "$base/tmp" 2>/dev/null || _warn_chmod "$base/tmp"
	chown "$OC_USER:$OC_USER" "$base/tmp" 2>/dev/null || _warn_chown "$base/tmp"

	# 上一次启动若因 schema 版本落后而失败，这里先修一次再启动（每开机一次）。
	oc_schema_heal "$base" "$state_dir" "$home" "$node_bin" "$entry"

	# --- --force lets OpenClaw kill a conflicting listener, but only when it
	#     can do so safely and only on unprivileged ports.
	if [ "$port" -gt 1024 ] 2>/dev/null &&
		{ command -v lsof >/dev/null 2>&1 || command -v fuser >/dev/null 2>&1; }; then
		force_opt="--force"
	fi

	# ── VAR 域可访问性：只断言，不修 ─────────────────────────────────
	#
	# 这里以前做「属主探测 + 条件 chown -R」。三个问题：
	#   1. 判据是 root 视角（stat -c %U）。root 对被 root 拥有的 0755 目录
	#      永远可写，所以这类判据只能看出"属主名字不对"，看不出"服务用户
	#      实际打不开" —— 表现为改完网关仍然 EACCES。
	#   2. 判据只看顶层属主。内部被 root 写过的文件（doctor 以 root 跑就会
	#      产生）不会被发现；一旦发现就退回全树 chown -R，7~8G、几万文件、
	#      几十秒，还可能与正在运行的网关抢同一批文件。
	#   3. "修了反而起不来"正是这类事后修正的产物。
	# 现在只做 O(1) 断言，并以**服务用户身份**验证真的能写；
	# 失败就 fail closed（不启动），给出可直接复制的修复命令。
	# 真正的属主修正在显式维护命令里（repair / adopt），不在启动路径。
	_var_problem=""
	if [ "$(stat -c %U "$home" 2>/dev/null)" != "$OC_USER" ]; then
		_var_problem="$home 属主不是 $OC_USER"
	fi
	if [ -z "$_var_problem" ] && [ "$(stat -c %U "$state_dir" 2>/dev/null)" != "$OC_USER" ]; then
		_var_problem="$state_dir 属主不是 $OC_USER"
	fi
	# 用户视角探针：这是唯一可信的"服务用户能不能写"判据。
	if [ -z "$_var_problem" ] && ! _probe_user_write "$state_dir"; then
		_var_problem="$state_dir 对 $OC_USER 不可写（root 视角可能显示正常）"
	fi

	if [ -n "$_var_problem" ]; then
		logger -t openclaw "拒绝启动：$_var_problem"
		logger -t openclaw "修复：/usr/libexec/openclaw/repair.sh owner-fix   （或 LuCI「一键修复」）"
		return 1
	fi

	# 顶层权限位补一次（防 mode 被改），不递归。
	chmod u+rwX "$home" 2>/dev/null || true

	env_args="$(_env_args "$state_dir/.env")"
	# 只在拿到明文 token 时才导出 OPENCLAW_GATEWAY_TOKEN。
	# SecretRef（{"source":"store",...}）是**引用**不是明文：塞进环境变量
	# 会让 /proc/<pid>/environ 常驻一段 JSON，而网关拿它认证必然失败。
	# 明文 token 里若有空白会破坏 procd 的 env 扁平列表，那种情况也不用它
	# （网关仍会读配置文件里的值）。
	token_env=""
	# token 只可能是 PLAIN 的明文（oc_credential_probe 已把引用式清空），
	# 所以这里只需判空。含空白的明文同样不导出。
	if [ -n "$token" ]; then
		token_env="OPENCLAW_GATEWAY_TOKEN=$token"
	fi
	# 密码模式：官方建议优先用环境变量而非 --password（后者会出现在 ps 里）。
	# 读取不接 head -n1（避免含 LF 时静默截断），并复用与 token 相同的
	# 空白判据；任何空格 / Tab / CR / LF 都不进入 procd env。
	# SecretRef 对象不是明文，交给网关从配置解析。
	#
	# 读取必须用 _oc_cred_json 而不是 json_get：json_get 在 jsonfilter 缺失 /
	# 文件不可读 / JSON 坏掉时静默返回空串，会被下面的 ''|null 分支吞成
	# "没配置密码"而继续启动 —— 现场表现是"起来了但认证失败"。token 通道在
	# 同样情形判 UNREAD 并拒绝，两条通道必须同一口径（fail-closed）。
	pw_env=""
	if [ "$authmode" = "password" ]; then
		authpw="$(_oc_cred_json "$cfg" '@.gateway.auth.password')"
		prc=$?
		# fail-closed 判据（与 token 通道的 UNREAD 同口径）：
		#   * 127 = jsonfilter 缺失 / 文件不可读 —— 直接拒绝；
		#   * 其它非零且没有任何输出 —— 无法区分"字段不存在"与"读不了"，
		#     用"整份文档能否解析"来判定：文档坏掉就拒绝，文档正常才算没配置。
		# 只挂 127 是不够的：JSON 坏掉时 jsonfilter 可能返回 1 而不是 127，
		# 那时空输出会被 '' 分支吞成"没配置密码"，继续启动。
		if [ "$prc" -ne 0 ]; then
			# 任何非零都表示字段查询失败，不能依赖 stdout 是否为空：
			# 错误路径若吐出半截值，继续执行会把半截密码导出到 procd env。
			# 只有 rc=0 + 空输出才表示"password 字段确实缺失/为空"。
			if [ "$prc" = "127" ]; then
				logger -t openclaw "无法读取配置 $cfg（jsonfilter 不可用或文件不可读），拒绝启动"
			else
				logger -t openclaw "无法查询 gateway.auth.password（jsonfilter rc=$prc，配置 $cfg），拒绝启动"
			fi
			return 1
		fi
		case "$authpw" in
			''|null|NULL|'{'*|'['*) : ;;
			*)
				if oc_cred_env_safe "$authpw"; then
					pw_env="OPENCLAW_GATEWAY_PASSWORD=$authpw"
				else
					logger -t openclaw "提示：明文网关密码含空白/换行控制字符，未导出到环境变量（网关仍读配置文件）"
				fi
				;;
		esac
	fi

	# 临时根必须在 procd 起网关**之前**钉好：
	#  - 钉成 root:root 0700 后，root 永远命中 preferred /tmp/openclaw，
	#    不会在 VAR 域（$base/tmp）里造 openclaw-0 被后续 chown 翻属主；
	#  - 服务用户因此走自己的 $TMPDIR/openclaw-<uid>，日志落在磁盘而不是
	#    tmpfs（重启不再丢）。
	_pin_system_tmp_root
	_sweep_stale_tmp

	# 身份一眼可查：排查时不用再猜"这次是谁在跑"
	logger -t openclaw "启动：user=$OC_USER(uid=$(id -u "$OC_USER" 2>/dev/null)) base=$base state=$state tmp_root=$(stat -c '%U:%a' /tmp/openclaw 2>/dev/null)"

	procd_open_instance "gateway"
	# token 不作为 --token 传：任何本地用户都能读 /proc/<pid>/cmdline，
	# 那样凭据在网关运行期间一直世界可读。OPENCLAW_GATEWAY_TOKEN 是官方
	# 文档给出的等价方式（优先级还高于配置文件）。
	#
	# --auth 跟随配置里的 gateway.auth.mode，不再无条件钉死为 token：
	# 官方 --auth 接受 none / token / password / trusted-proxy。以前无论
	# 配置写什么都是 --auth token，等于让插件与配置项打架。
	procd_set_param command "$node_bin" "$entry" gateway run \
		--port "$port" --bind "$bind" --auth "$authmode" \
		--allow-unconfigured $force_opt
	# HOME / OPENCLAW_HOME 表示进程 HOME，与 state 目录是两个概念，保持不变。
	# 但 STATE_DIR / CONFIG_PATH 不能写死 "$home/.openclaw"：main.state_dir 可
	# 覆盖 state_dir（迁移已有安装到大容量盘），写死会让网关与 UI 操作
	# 不同的目录 —— 网关按这里读 token、UI 按 state_dir 写配置，表现为
	# 「改了模型/端口不生效」「API Key 写了仍报未配置」。
	# shellcheck disable=SC2086
	procd_set_param env \
		HOME="$home" \
		OPENCLAW_HOME="$home" \
		OPENCLAW_STATE_DIR="$state_dir" \
		OPENCLAW_CONFIG_PATH="${state_dir}/openclaw.json" \
		OPENCLAW_GATEWAY_PORT="$port" \
		OPENCLAW_GATEWAY_BIND="$bind" \
		TMPDIR="$base/tmp" \
		PATH="${nodedir}/bin:${globaldir}/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
		$token_env \
		$pw_env \
		$env_args
	# 无条件设置：走到这里 user_opt 必然等于 $OC_USER（上面的 fail-closed
	# 检查已经保证该用户存在）。绝不能再加 [ -n ] 之类的条件 —— 一旦条件
	# 不成立，procd 会以 root 启动网关且没有任何提示。
	procd_set_param user "$user_opt"
	# respawn <threshold> <timeout> <retry>：retry=0 表示**永不放弃**。
	# 旧值 5 是"一小时内崩 5 次就彻底不再拉起"—— 段错误这类问题恰恰会连续崩，
	# 于是表现成"停了再也不回来"，只能手动 /etc/init.d/openclaw start。
	# timeout=5 是首次重启延迟，逐次翻倍、封顶 threshold(3600s)，所以"永不放弃"
	# 不会变成狂刷：退避到 1 小时才重试一次。
	procd_set_param respawn 3600 5 0
	# pidfile 之前**只有 stop 分支会删、没有任何写入点**，于是 running() 里
	# `[ -f /var/run/openclaw.pid ]` 这条兜底恒不成立。交给 procd 维护。
	procd_set_param pidfile /var/run/openclaw.pid
	# term_timeout：给插件收尾的时间。procd 默认只有 5 秒，而插件会抓着资源
	# 不放（实测日志："Plugin deepseek forced retirement after 5000ms: 1
	# still-running call(s)"），5 秒必然走到 SIGKILL，留下半关闭的 sqlite。
	procd_set_param term_timeout 30

	# core dump：默认关（main.core_dumps=1 才开）。打开后 procd 解除 RLIMIT_CORE，
	# 并把 core_pattern 指到安装目录下的 logs/ —— 那是大容量盘，不会写满 overlay。
	# 注意 core_pattern 是**全局**设置，只在这个开关打开时才改：
	# 别的程序也在用同一份内核设置，不该被插件无条件改掉。
	if [ "$core_dumps" = "1" ]; then
		# 必须是单值。procd 把 "unlimited unlimited" 按空格拆成 soft/hard，
		# 但 soft 位只认数值或单个 unlimited，写两个 unlimited 会让 soft 退化成 0。
		# 同机对照：unetd/hostapd/netifd 用 core="unlimited" → unlimited/unlimited；
		# 本服务原来用双 unlimited → 0/unlimited，等于 core dump 一直没开。
		# （双值**数值**写法是有效的，dockerd 的 nofile="1048576 1048576" 就对。）
		procd_set_param limits core="unlimited"
		mkdir -p "$base/logs" 2>/dev/null || true
		chown "$OC_USER:$OC_USER" "$base/logs" 2>/dev/null || _warn_chown "$base/logs"
		# %e 可执行名 %t 时间戳 %p pid %s 信号
		# 落 DIAG 域（根属主 0700），不落 VAR 域：core 的属主取决于崩溃进程，
		# 混进用户域会制造"非服务用户属主的文件"，清理还得动用户域。
		mkdir -p "$base/dumps" 2>/dev/null || true
		chown root:root "$base/dumps" 2>/dev/null || true
		chmod 700 "$base/dumps" 2>/dev/null || true
		printf '%s/core.%%e.%%t.%%p.%%s\n' "$base/dumps" >/proc/sys/kernel/core_pattern 2>/dev/null \
			|| logger -t openclaw "无法写入 core_pattern，core 可能落到默认位置"
		logger -t openclaw "core dump 已开启：$base/logs"
	fi
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t openclaw "started (base=$base port=$port bind=$bind)"
}

stop_service() {
	# procd stops the instance; never blanket-kill by name here (that used to
	# take down unrelated processes matching 'openclaw').
	rm -f /var/run/openclaw.pid 2>/dev/null || true
	logger -t openclaw "stopped"
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$OC_UCI"
}
