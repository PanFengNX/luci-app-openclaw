{
	"luci-app-openclaw": {
		"description": "Grant access to OpenClaw 助手 (openclaw) configuration",
		"read": {
			"file": {
				"/etc/config/openclaw": [ "read" ],
				"/var/log/openclaw.log": [ "read" ],
				"/var/log/openclaw-install.log": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/etc/config/openclaw": [ "write" ]
			}
		}
	}
}
