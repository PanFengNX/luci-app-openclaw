config main 'main'
	option enabled '0'
	option base_dir ''
	option openclaw_dir ''
	# 数据根目录：openclaw.json / .env / 会话 / 工作区都在它下面。
	# 为空表示使用 <安装目录>/home/.openclaw（历史默认，与旧版本行为一致）；
	# 非空时以它为准 —— 例如把数据放到大容量盘，或指向本机已有的 OpenClaw 数据目录。
	option state_dir ''
	option port '18789'
	option bind 'lan'
	option oc_version 'latest'
	option node_version 'auto'
	# Node.js 部署方式（默认 global）：
	#   global  解压到 /usr/lib/nodejs 并链接到 /usr/bin/node|npm|npx，全系统可用
	#   private 解压到 <安装目录>/node，只有本插件使用，不占用 overlay、不动系统目录
	# 空间不足时安装会明确报错并提示改用 private（global 落在 overlay 上，装不下会连带影响配置落盘）。
	option node_mode 'global'
	option npm_registry ''
	option node_mirror ''
	option http_proxy ''
	# Node.js 压缩包的 SHA256 校验是强制的：校验清单拉不到、清单里没有该文件、
	# 或系统缺少 sha256sum，安装都会中止。只有明确接受「可能装到被替换的二进制」
	# 这一风险时，才把它置 1 跳过校验（每次跳过都会写进安装日志）。
	option allow_unverified_node '0'
	# 下载可执行文件（Node.js 运行时）只允许 https。内网镜像只有明文 http 时，
	# 置 1 才会降级放行，并在安装日志里告警一次。
	option allow_http_binaries '0'
	option preinstall_providers 'deepseek'
	# 安装成功后自动启动服务（1=设置开机自启并启动，0=装完保持停止，稍后手动启动）
	option auto_start '1'
	# 云备份：定时备份（按周期自动打包上传，并保留最近 N 份）
	#   cloud_enabled  1=启用（在 crontab 写入带 openclaw-cloud 标记的行），0=关闭
	#   cloud_period   daily=每天 | weekly=每周（仅 weekly 使用 cloud_weekday）
	#   cloud_weekday  0=周日 … 6=周六（cron 里 0 与 7 都表示周日，这里统一用 0）
	#   cloud_hour     0-23
	#   cloud_minute   0-59
	#   cloud_keep     保留最近 N 份（1-30），只清理符合 openclaw-*.tar.gz[.enc] 的文件
	#   cloud_encrypt  上传前是否加密（0=明文上传，1=AES-256-GCM 加密；默认 0）
	#                  加密是否启用只看本开关；口令只是加密的必要条件（1 且未设口令时上传报错）
	option cloud_enabled '0'
	option cloud_encrypt '0'
	option cloud_period 'daily'
	option cloud_weekday '0'
	option cloud_hour '4'
	option cloud_minute '30'
	option cloud_keep '7'
	option installed '0'
